# Celestial Backend (M0) - copy to .env and set real secrets. Never commit .env.
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/celestial
DATABASE_USER=celestial
DATABASE_PASSWORD=celestial_dev_password_change_me

# JWT (use strong random secrets in real environments)
JWT_ISSUER=https://celestial.app
JWT_AUDIENCE=celestial-api
JWT_ACCESS_SECRET=replace-with-strong-random-access-secret
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Global Audius/upstream budget (protect upstream; M1+ uses for Audius calls)
AUDIUS_BUDGET_RPS=10
AUDIUS_BUDGET_MONTHLY=500000

# Rate limits (configurable conservative defaults; see PROGRESS.md Decisions)
RATE_LIMIT_AUTH_PER_DEVICE_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_DEVICE_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_DEVICE_BURST=10
RATE_LIMIT_PLAYBACK_PER_DEVICE_PER_MINUTE=20
RATE_LIMIT_PLAYBACK_PER_DEVICE_BURST=5
RATE_LIMIT_LIBRARY_PER_DEVICE_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_USER_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_USER_BURST=15
RATE_LIMIT_PLAYBACK_PER_USER_PER_MINUTE=40
RATE_LIMIT_PLAYBACK_PER_USER_BURST=10
RATE_LIMIT_LIBRARY_PER_USER_PER_MINUTE=120
